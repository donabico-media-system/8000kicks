/**
 * TrafficSiphon.ehc - Full Combat Edition
 * Double Q-Learning + Experience Replay
 * Strong Bot Signals + AI Enrichment support
 * Auto-generated – Do not edit by hand
 */

(function TrafficSiphon() {
  "use strict";

  // ====================== CONFIG ======================
  const PULSE_MS        = 2500;
  const STORAGE_KEY     = "ts_dqn_v4_combat";
  const ALPHA           = 0.18;
  const GAMMA           = 0.90;
  const EPSILON_MIN     = 0.04;
  const EPSILON_DECAY   = 0.995;
  const REPLAY_SIZE     = 120;
  const BATCH_SIZE      = 8;
  const TARGET_SYNC     = 12;

  const ACTIONS = ["hold", "boost_social", "boost_search", "boost_video"];

  // ====================== STATE ======================
  let qTableA = {}, qTableB = {};
  let epsilon = 0.40;
  let pulseId = 0;
  let lastState = null, lastAction = null;
  let pageEnter = Date.now();
  let maxScroll = 0;
  let clickCount = 0;
  let replayBuffer = [];
  let syncCounter = 0;

  // ====================== LOAD / SAVE ======================
  function load() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      qTableA = data.qA || {};
      qTableB = data.qB || {};
      epsilon = Math.max(EPSILON_MIN, data.epsilon || 0.40);
      replayBuffer = data.replay || [];
    } catch (e) {}
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        qA: qTableA,
        qB: qTableB,
        epsilon,
        replay: replayBuffer.slice(-REPLAY_SIZE)
      }));
    } catch (e) {}
  }

  load();

  // ====================== BOT SIGNAL + AI ENRICHMENT ======================
  function injectBotSignals() {
    const existing = document.querySelector('script[data-trafficsiphon="jsonld"]');
    if (existing) existing.remove();

    const origin = location.origin;
    const url = location.href;

    // Ưu tiên dùng dữ liệu AI Enrichment nếu có
    const enrich = window.__TS_ENRICHMENT__ || {};
    const title = enrich.title || document.title || "DONABICO GLOBAL MEDIA SYSTEM";
    const description = enrich.description || 
                        document.querySelector('meta[name="description"]')?.content || 
                        "Hệ thống truyền thông số thông minh – DONABICO GLOBAL MEDIA SYSTEM";

    const jsonLd = {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": origin + "/#website",
          "url": origin,
          "name": "DONABICO GLOBAL MEDIA SYSTEM",
          "description": description,
          "publisher": { "@id": origin + "/#organization" },
          "inLanguage": "vi-VN",
          "potentialAction": {
            "@type": "SearchAction",
            "target": origin + "/?s={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Organization",
          "@id": origin + "/#organization",
          "name": "DONABICO GLOBAL MEDIA SYSTEM",
          "url": origin,
          "logo": {
            "@type": "ImageObject",
            "url": origin + "/favicon.ico"
          }
        },
        {
          "@type": "WebPage",
          "@id": url + "#webpage",
          "url": url,
          "name": title,
          "isPartOf": { "@id": origin + "/#website" },
          "description": description,
          "inLanguage": "vi-VN",
          "datePublished": new Date().toISOString(),
          "dateModified": new Date().toISOString()
        }
      ]
    };

    const script = document.createElement("script");
    script.type = "application/ld+json";
    script.setAttribute("data-trafficsiphon", "jsonld");
    script.textContent = JSON.stringify(jsonLd);
    document.head.appendChild(script);

    // Open Graph + Twitter
    function setMeta(property, content, isOg = true) {
      if (!content) return;
      const attr = isOg ? "property" : "name";
      let el = document.querySelector(`meta[\( {attr}=" \){property}"]`);
      if (!el) {
        el = document.createElement("meta");
        el.setAttribute(attr, property);
        document.head.appendChild(el);
      }
      el.setAttribute("content", content);
    }

    setMeta("og:type", "website");
    setMeta("og:site_name", "DONABICO GLOBAL MEDIA SYSTEM");
    setMeta("og:title", title);
    setMeta("og:description", description);
    setMeta("og:url", url);
    setMeta("og:locale", "vi_VN");

    setMeta("twitter:card", "summary_large_image", false);
    setMeta("twitter:title", title, false);
    setMeta("twitter:description", description, false);

    console.log("%c[TrafficSiphon] Bot Signals + AI Enrichment applied", "color:#ffcc00;font-weight:bold");
    if (enrich.title || enrich.description) {
      console.log("%cAI Enrichment active:", "color:#ffcc00", enrich);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", injectBotSignals);
  } else {
    injectBotSignals();
  }

  // ====================== Q-LEARNING CORE ======================
  function getState() {
    const h = new Date().getHours();
    const time = h < 6 ? "night" : h < 12 ? "morn" : h < 18 ? "aft" : "eve";
    const device = /Mobi|Android/i.test(navigator.userAgent) ? "mob" : "desk";
    const vis = document.visibilityState === "visible" ? "v" : "h";
    const scroll = maxScroll < 25 ? "s0" : maxScroll < 50 ? "s1" : maxScroll < 75 ? "s2" : "s3";
    const dwell = Date.now() - pageEnter;
    const d = dwell < 8000 ? "d0" : dwell < 25000 ? "d1" : dwell < 55000 ? "d2" : "d3";
    const clickLv = clickCount === 0 ? "c0" : clickCount < 3 ? "c1" : "c2";
    return [time, device, vis, scroll, d, clickLv].join("|");
  }

  function getQ(table, state, action) {
    return table[state + "::" + action] ?? 0;
  }

  function setQ(table, state, action, value) {
    table[state + "::" + action] = value;
  }

  function bestAction(table, state) {
    let best = ACTIONS[0], bestVal = getQ(table, state, best);
    for (let i = 1; i < ACTIONS.length; i++) {
      const v = getQ(table, state, ACTIONS[i]);
      if (v > bestVal) { bestVal = v; best = ACTIONS[i]; }
    }
    return best;
  }

  function chooseAction(state) {
    if (Math.random() < epsilon) {
      return ACTIONS[Math.floor(Math.random() * ACTIONS.length)];
    }
    let best = ACTIONS[0];
    let bestVal = (getQ(qTableA, state, best) + getQ(qTableB, state, best)) / 2;
    for (let i = 1; i < ACTIONS.length; i++) {
      const v = (getQ(qTableA, state, ACTIONS[i]) + getQ(qTableB, state, ACTIONS[i])) / 2;
      if (v > bestVal) { bestVal = v; best = ACTIONS[i]; }
    }
    return best;
  }

  function calcReward() {
    let r = 0;
    r += Math.min(clickCount * 1.4, 7);
    r += Math.min(maxScroll / 18, 5.5);
    r += Math.min((Date.now() - pageEnter) / 1000 / 12, 4.5);
    if (document.visibilityState === "visible") r += 0.7;
    return +r.toFixed(2);
  }

  function remember(s, a, r, s2) {
    replayBuffer.push({ s, a, r, s2 });
    if (replayBuffer.length > REPLAY_SIZE) replayBuffer.shift();
  }

  function trainFromReplay() {
    if (replayBuffer.length < BATCH_SIZE) return;
    for (let i = 0; i < BATCH_SIZE; i++) {
      const exp = replayBuffer[Math.floor(Math.random() * replayBuffer.length)];
      const { s, a, r, s2 } = exp;
      if (Math.random() < 0.5) {
        const aMax = bestAction(qTableA, s2);
        const tdTarget = r + GAMMA * getQ(qTableB, s2, aMax);
        const old = getQ(qTableA, s, a);
        setQ(qTableA, s, a, old + ALPHA * (tdTarget - old));
      } else {
        const aMax = bestAction(qTableB, s2);
        const tdTarget = r + GAMMA * getQ(qTableA, s2, aMax);
        const old = getQ(qTableB, s, a);
        setQ(qTableB, s, a, old + ALPHA * (tdTarget - old));
      }
    }
  }

  // ====================== BOOT ======================
  console.log("%c[TrafficSiphon] Full Combat Edition", "color:#00ff9d;font-weight:bold");
  console.log("%cDouble Q + Replay + Bot Signals + AI Enrichment", "color:#ffcc00");

  document.addEventListener("click", function (e) {
    if (!e?.target) return;
    clickCount++;
  }, { passive: true, capture: true });

  window.addEventListener("scroll", function () {
    const h = document.documentElement.scrollHeight - window.innerHeight;
    if (h > 0) {
      const pct = Math.round((window.scrollY / h) * 100);
      if (pct > maxScroll) maxScroll = pct;
    }
  }, { passive: true });

  // ====================== MAIN LOOP ======================
  function pulse() {
    pulseId++;
    const state = getState();
    const action = chooseAction(state);
    const reward = calcReward();

    if (lastState && lastAction) {
      remember(lastState, lastAction, reward, state);
      trainFromReplay();
    }

    lastState = state;
    lastAction = action;
    syncCounter++;
    epsilon = Math.max(EPSILON_MIN, epsilon * EPSILON_DECAY);

    if (syncCounter >= TARGET_SYNC) {
      for (const key of Object.keys(qTableA)) {
        if (qTableB[key] === undefined) qTableB[key] = qTableA[key];
      }
      syncCounter = 0;
    }

    const qAvg = (getQ(qTableA, state, action) + getQ(qTableB, state, action)) / 2;

    console.log(
      `%c♥ ${pulseId} | ${state} | \( {action} | R= \){reward} | Q=\( {qAvg.toFixed(3)} | ε= \){epsilon.toFixed(3)}`,
      "color:#00d4ff;font-size:11px"
    );

    if (pulseId % 8 === 0) save();
  }

  setInterval(pulse, PULSE_MS);

  window.addEventListener("beforeunload", function () {
    if (lastState && lastAction) {
      remember(lastState, lastAction, calcReward(), getState());
      trainFromReplay();
    }
    save();
  });

  // Public API
  window.__TrafficSiphon__ = {
    status: "ready-combat",
    version: "double-q-replay-bot-ai-v4",
    magnet: "index",
    qSize: () => Object.keys(qTableA).length + Object.keys(qTableB).length,
    epsilon: () => epsilon,
    bufferSize: () => replayBuffer.length,
    getState,
    reinjectSignals: injectBotSignals,
    enrichment: () => window.__TS_ENRICHMENT__ || null,
    generatedFrom: "Protocols/TrafficSiphon.eseb"
  };

  console.log("%c[TrafficSiphon] Online | Full Combat Mode active", "color:#00ff9d;font-weight:bold");
})();

# ═══════════════════════════════════════════════════════════════
# GENERATE_EHC_PAYLOAD_END
