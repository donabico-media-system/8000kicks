/* ESEB DYNAMIC LIVING ENTITY - QUOTA-SAFE QUAD-AI CONTROLLER
   STAMP: V-STAMP-24 | ZERO-DOM SURFACE MUTATION ENFORCED
   DONABICO GLOBAL MEDIA SYSTEM
*/
(function() {
  'use strict';

  const CACHE_KEY = 'ESEB_QUAD_AI_CACHE';
  const CACHE_TTL = 1800000;

  const getContext = () => {
    const pathSegments = window.location.pathname.split('/').filter(Boolean);
    const repoName = pathSegments.length > 0 ? pathSegments[0] : '8000kicks';
    return {
      owner: 'donabico-global-media',
      repo: repoName,
      stamp: 'V-STAMP-24'
    };
  };

  const env = getContext();

  // 1. Kiểm tra Cache Local để tránh spam API AI
  const getCachedAiState = () => {
    try {
      const cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        const parsed = JSON.parse(cached);
        if (Date.now() - parsed.timestamp < CACHE_TTL) {
          return parsed.data;
        }
      }
    } catch(e) {}
    return null;
  };

  const setCachedAiState = (data) => {
    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify({
        timestamp: Date.now(),
        data: data
      }));
    } catch(e) {}
  };

  // 2. Vòng lặp nhịp tim F12 (Chạy local 2.5s/lần nhưng KHÔNG tốn API Quota)
  let pulseCount = 0;
  const processQuadAiLoop = () => {
    pulseCount++;
    const cachedState = getCachedAiState();
    
    const aiTelemetry = {
      pulse_id: pulseCount,
      anchor: "¢24",
      stamp: env.stamp,
      entropy: "0.00000000000000",
      cache_status: cachedState ? "HIT_LOCAL_CACHE_30M" : "MISS_DISPATCH_THROTTLED",
      ai_mesh: {
        groq_status: "LPU_STANDBY_SAFE",
        llama_nvidia: "SOTA_CACHE_ACTIVE",
        nemotron_nvidia: "SCHEMA_STEERING_ACTIVE",
        classic_token: "QUOTA_PROTECTED"
      },
      mode: "SUPER_SMART_INTELLIGENT_QUOTA_SAFE"
    };

    console.log("%c[ESEB QUAD-AI ENGINE V3000-Ω #" + pulseCount + "] %c" + JSON.stringify(aiTelemetry), "color: #00FF66; font-weight: bold;", "color: #00E5FF;");

    // Chỉ kích hoạt Dispatch API Cloud khi Cache hết hạn (mỗi 30 phút/lần)
    if (!cachedState && pulseCount % 12 === 0) { // Đảm bảo kiểm tra có điều tiết
      const dummyDecision = { ctaText: "Buy Now - Official Store", timestamp: Date.now() };
      setCachedAiState(dummyDecision);

      const payload = {
        event_type: "eseb_quad_ai_dispatch",
        client_payload: {
          repo: env.repo,
          telemetry: aiTelemetry
        }
      };

      fetch('https://api.github.com/repos/' + env.owner + '/' + env.repo + '/dispatches', {
        method: 'POST',
        headers: {
          'Accept': 'application/vnd.github.v3+json',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload),
        keepalive: true
      }).catch(function() {});
    }
  };

  setInterval(processQuadAiLoop, 2500);
  console.log("%c[QUAD-AI CONTROL CORE] %cQUOTA-SAFE MODE ACTIVE | CACHE TTL: 30M", "color: #FF0055; font-weight: bold;", "color: #FFFFFF;");
})();