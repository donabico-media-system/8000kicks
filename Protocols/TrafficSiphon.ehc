  let replayBuffer = [];
  let syncCounter = 0;
  let actionCount = { hold: 0, boost_social: 0, boost_search: 0, boost_video: 0 };

  function load() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);
      qTableA = data.qA || {};
      qTableB = data.qB || {};
      epsilon = Math.max(EPSILON_MIN, data.epsilon || 0.40);
      replayBuffer = data.replay || [];
      actionCount = data.actionCount || actionCount;
    } catch (e) {}
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        qA: qTableA,
        qB: qTableB,
        epsilon: epsilon,
        replay: replayBuffer.slice(-REPLAY_SIZE),
        actionCount: actionCount
      }));
    } catch (e) {}
  }

  load();

  // ===== REAL ACTIONS (Zero-DOM) =====
  function executeAction(action, state, reward) {
    actionCount[action] = (actionCount[action] || 0) + 1;

    // 1. Luôn đẩy vào dataLayer (GTM / GA4 / bất kỳ tracker nào đang lắng nghe)
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: "trafficsiphon_action",
      ts_action: action,
      ts_state: state,
      ts_reward: reward,
      ts_pulse: pulseId,
      ts_source: "TrafficSiphon",
      ts_stamp: "V-STAMP-24"
    });

    // 2. Dispatch CustomEvent để script khác có thể lắng nghe
    try {
      const ev = new CustomEvent("trafficsiphon:action", {
        detail: { action, state, reward, pulseId, timestamp: Date.now() }
      });
      window.dispatchEvent(ev);
    } catch (e) {}

    // 3. Hành động riêng theo từng loại
    if (action === "boost_social") {
      // Thử Web Share API (nếu trình duyệt + HTTPS hỗ trợ)
      if (navigator.share && location.protocol === "https:") {
        // Không tự động gọi share để tránh làm phiền user, chỉ chuẩn bị dữ liệu
        window.__TS_SHARE_DATA__ = {
          title: (window.__TS_ENRICHMENT__ && window.__TS_ENRICHMENT__.title) || document.title,
          text: (window.__TS_ENRICHMENT__ && window.__TS_ENRICHMENT__.description) || "",
          url: location.href
        };
      }
      console.log("%c[TS] REAL → boost_social | dataLayer + event fired", "color:#ff79c6");
    }

    if (action === "boost_search") {
      // Gửi tín hiệu nhẹ (beacon) – không chặn trang
      try {
        if (navigator.sendBeacon) {
          const blob = new Blob([JSON.stringify({
            type: "boost_search",
            url: location.href,
            title: document.title,
            t: Date.now()
          })], { type: "application/json" });
          // Beacon đến chính origin (an toàn, không cần endpoint ngoài)
