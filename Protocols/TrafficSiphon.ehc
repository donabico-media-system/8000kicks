/* Auto-generated by TrafficSiphon workflow | 2026-08-08T11:55:41Z */
/* Source: Protocols/TrafficSiphon.eseb | Do not edit by hand */
/**
 * TrafficSiphon.ehc
 * Auto-generated from Protocols/TrafficSiphon.eseb
 * Practical Q-Learning (real states + rewards + localStorage)
 * Do not edit manually
 */

(function TrafficSiphon() {
  "use strict";

  // ── Config ───────────────────────────────────────────────────
  const PULSE_MS   = 2500;
  const STORAGE_KEY = "ts_qtable_v1";
  const ALPHA      = 0.15;   // learning rate
  const GAMMA      = 0.85;   // discount
  const EPSILON_MIN = 0.05;
  const EPSILON_DECAY = 0.997;

  // Actions the agent can choose (internal priority only, Zero-DOM)
  const ACTIONS = ["hold", "boost_social", "boost_search", "boost_video"];

  // ── State ────────────────────────────────────────────────────
  let qTable     = loadQTable();
  let epsilon    = loadEpsilon();
  let pulseId    = 0;
  let lastState  = null;
  let lastAction = null;
  let pageEnter  = Date.now();
  let maxScroll  = 0;
  let clickCount = 0;

  // ── Helpers ──────────────────────────────────────────────────
  function loadQTable() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch (e) { return {}; }
  }

  function saveQTable() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(qTable));
      localStorage.setItem(STORAGE_KEY + "_eps", String(epsilon));
    } catch (e) {}
  }

  function loadEpsilon() {
    try {
      const v = localStorage.getItem(STORAGE_KEY + "_eps");
      return v ? Math.max(EPSILON_MIN, parseFloat(v)) : 0.35;
    } catch (e) { return 0.35; }
  }

  function getState() {
    const hour = new Date().getHours();
    const timeBucket = hour < 6 ? "night" : hour < 12 ? "morning" : hour < 18 ? "afternoon" : "evening";
    const device = /Mobi|Android/i.test(navigator.userAgent) ? "mobile" : "desktop";
    const visible = document.visibilityState === "visible" ? "vis" : "hid";
    const scrollBucket = maxScroll < 25 ? "s0" : maxScroll < 50 ? "s1" : maxScroll < 75 ? "s2" : "s3";
    const dwell = Date.now() - pageEnter;
    const dwellBucket = dwell < 10000 ? "d0" : dwell < 30000 ? "d1" : dwell < 60000 ? "d2" : "d3";
    return [timeBucket, device, visible, scrollBucket, dwellBucket].join("|");
  }

  function getQ(state, action) {
    const key = state + "::" + action;
    return qTable[key] !== undefined ? qTable[key] : 0;
  }

  function setQ(state, action, value) {
    const key = state + "::" + action;
    qTable[key] = value;
  }

  function chooseAction(state) {
    // epsilon-greedy
    if (Math.random() < epsilon) {
      return ACTIONS[Math.floor(Math.random() * ACTIONS.length)];
    }
    let best = ACTIONS[0];
    let bestVal = getQ(state, best);
    for (let i = 1; i < ACTIONS.length; i++) {
      const v = getQ(state, ACTIONS[i]);
      if (v > bestVal) {
        bestVal = v;
        best = ACTIONS[i];
      }
    }
    return best;
  }

  function updateQ(state, action, reward, nextState) {
    const old = getQ(state, action);
    let maxNext = getQ(nextState, ACTIONS[0]);
    for (let i = 1; i < ACTIONS.length; i++) {
      maxNext = Math.max(maxNext, getQ(nextState, ACTIONS[i]));
    }
    const td = reward + GAMMA * maxNext - old;
    setQ(state, action, old + ALPHA * td);
    epsilon = Math.max(EPSILON_MIN, epsilon * EPSILON_DECAY);
    saveQTable();
  }

  function calcReward() {
    // Real reward from user behavior
    let r = 0;
    r += Math.min(clickCount * 1.2, 6);           // clicks
    r += Math.min(maxScroll / 20, 5);             // scroll depth
    const dwellSec = (Date.now() - pageEnter) / 1000;
    r += Math.min(dwellSec / 15, 4);              // time on page
    if (document.visibilityState === "visible") r += 0.5;
    return +r.toFixed(2);
  }

  // ── Boot ─────────────────────────────────────────────────────
  console.log("%c[TrafficSiphon] Started | Practical Q-Learning | Zero-DOM", "color:#00ff9d;font-weight:bold");
  console.log("%cStates: time|device|visibility|scroll|dwell | Actions: " + ACTIONS.join(", "), "color:#7dffb3");
  console.log("%cQ-table entries: " + Object.keys(qTable).length + " | epsilon: " + epsilon.toFixed(3), "color:#7dffb3");

  // ── Track real user signals (Zero-DOM) ───────────────────────
  document.addEventListener("click", function (e) {
    if (!e || !e.target) return;
    clickCount++;
    const signal = {
      type: "click",
      target: e.target.tagName,
      magnet: "index"
    };
    if (window.__TRAFFIC_TELEMETRY__) window.__TRAFFIC_TELEMETRY__.push(signal);
  }, { passive: true, capture: true });

  window.addEventListener("scroll", function () {
    const h = document.documentElement.scrollHeight - window.innerHeight;
    if (h > 0) {
      const pct = Math.round((window.scrollY / h) * 100);
      if (pct > maxScroll) maxScroll = pct;
    }
  }, { passive: true });

  document.addEventListener("visibilitychange", function () {
    // state will be re-read on next pulse
  });

  // ── Main learning loop ───────────────────────────────────────
  function pulse() {
    pulseId++;
    const state  = getState();
    const action = chooseAction(state);
    const reward = calcReward();

    // Temporal-difference update from previous step
    if (lastState !== null && lastAction !== null) {
      updateQ(lastState, lastAction, reward, state);
    }

    lastState  = state;
    lastAction = action;

    const qVal = getQ(state, action);

    console.log(
      "%c♥ " + pulseId +
      " | S=" + state +
      " | A=" + action +
      " | R=" + reward +
      " | Q=" + qVal.toFixed(3) +
      " | ε=" + epsilon.toFixed(3),
      "color:#00d4ff;font-size:11px"
    );

    if (window.__TRAFFIC_TELEMETRY__) {
      window.__TRAFFIC_TELEMETRY__.push({
        pulseId: pulseId,
        state: state,
        action: action,
        reward: reward,
        q: qVal,
        epsilon: +epsilon.toFixed(4),
        magnet: "index"
      });
    }
  }

  setInterval(pulse, PULSE_MS);

  // Save on leave
  window.addEventListener("beforeunload", function () {
    if (lastState && lastAction) {
      updateQ(lastState, lastAction, calcReward(), getState());
    }
    saveQTable();
  });

  // Public status
  window.__TrafficSiphon__ = {
    status: "ready",
    magnet: "index",
    qSize: function () { return Object.keys(qTable).length; },
    epsilon: function () { return epsilon; },
    getState: getState,
    generatedFrom: "Protocols/TrafficSiphon.eseb"
  };

  console.log("%c[TrafficSiphon] Online | Q-Learning active | localStorage enabled", "color:#00ff9d;font-weight:bold");
})();

