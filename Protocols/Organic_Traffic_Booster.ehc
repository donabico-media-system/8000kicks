(function() {
    'use strict';
    
    const discoverContext = () => {
        const host = window.location.hostname;
        const pathParts = window.location.pathname.split('/').filter(Boolean);
        let targetDomain = '';
        let repoName = 'core-node';

        if (host.includes('github.io')) {
            repoName = pathParts[0] || 'core-node';
            targetDomain = `https://${host}/${repoName}/`;
        } else {
            repoName = host.split('.')[0] || 'custom-node';
            targetDomain = `https://${host}/`;
        }
        return { targetDomain, repoName };
    };

    const ctx = discoverContext();
    let pulseSeq = 0;

    function boot() {
        console.group('%c[ESEB AUTO-6D ENGINE] LIVING ENTITY ACTIVATED', 'color:#00FF66; background:#000; font-weight:bold; padding:4px;');
        console.log(`%c[Target Domain]: ${ctx.targetDomain}`, 'color:#00E5FF; font-weight:bold;');
        console.log(`%c[Target Repo]: ${ctx.repoName}`, 'color:#FFC107; font-weight:bold;');
        console.log(`%c[STAMP]: V-STAMP-24 | ANCHOR: ¢24 LOCKED`, 'color:#FF0055;');
        console.groupEnd();

        injectJSONLD();
        startPulse();
    }

    function injectJSONLD() {
        if (document.getElementById('eseb-auto6d-jsonld')) return;
        const schema = {
            "@context": "https://schema.org",
            "@type": "Product",
            "name": document.title || `${ctx.repoName} SOTA Node`,
            "url": ctx.targetDomain,
            "brand": { "@type": "Brand", "name": "DONABICO MEDIA SYSTEM" },
            "description": "Perpetual AUTO-6D Multi-Repo SGE/GEO Magnet Node.",
            "offers": { "@type": "AggregateOffer", "priceCurrency": "USD", "highPrice": "999", "lowPrice": "0", "offerCount": "24" }
        };
        const s = document.createElement('script');
        s.id = 'eseb-auto6d-jsonld';
        s.type = 'application/ld+json';
        s.text = JSON.stringify(schema);
        document.head.appendChild(s);
    }

    function startPulse() {
        setInterval(() => {
            pulseSeq++;
            const reward = (3.30 + Math.random() * 0.05).toFixed(2);
            console.log(
                `%c[ESEB PULSE 2.5s #%d] %c¢24 %c| Target: ${ctx.targetDomain} | Repo: ${ctx.repoName} | δ=0.00000000000000`,
                'color:#00E5FF; font-weight:bold;', pulseSeq, 'color:#FF0055; font-weight:bold;', 'color:#00FF66;'
            );
        }, 2500);
    }

    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', boot); }
    else { boot(); }
})();