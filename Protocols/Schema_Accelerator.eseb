import os, re, json

class SchemaAcceleratorEngine:
    def __init__(self):
        self.stamp = "V-STAMP-24"
        self.anchor = "¢24"
        self.brand = "DONABICO GLOBAL MEDIA SYSTEM"

    def patch_index_html_statically(self):
        """Tiêm trực tiếp Schema Merchant Listings W3C chứa validFrom vào index.html"""
        index_path = "index.html"
        if not os.path.exists(index_path):
            print("[WARN] index.html not found, skipping static patch.")
            return

        schema_json = {
            "@context": "https://schema.org/",
            "@type": "Product",
            "name": "8000Kicks Waterproof Hemp Shoes",
            "image": [
                "https://8000kicks.donabico.com/assets/product-main.jpg",
                "https://8000kicks.donabico.com/assets/product-angle2.jpg"
            ],
            "description": "The World's First 100% Waterproof Industrial Hemp Shoes. Engineered with natural hemp fibers, sustainable Bloom algae insoles, and dynamic rubber soles.",
            "sku": "8000KICKS-HEMP-001",
            "mpn": "8000K-2026-V24",
            "brand": { "@type": "Brand", "name": "8000kicks" },
            "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": "4.9",
                "reviewCount": "1280",
                "bestRating": "5",
                "worstRating": "1"
            },
            "review": [
                {
                    "@type": "Review",
                    "author": { "@type": "Person", "name": "Alexander Wright" },
                    "datePublished": "2026-05-15",
                    "reviewBody": "Best eco-friendly waterproof shoes ever! Extremely comfortable and lightweight.",
                    "name": "Superb Quality & Waterproof Performance",
                    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
                }
            ],
            "offers": {
                "@type": "Offer",
                "url": "https://8000kicks.donabico.com/",
                "priceCurrency": "USD",
                "price": "135.00",
                "validFrom": "2026-01-01T00:00:00+00:00",
                "priceValidUntil": "2027-12-31T23:59:59+00:00",
                "itemCondition": "https://schema.org/NewCondition",
                "availability": "https://schema.org/InStock",
                "seller": { "@type": "Organization", "name": "8000kicks Official Store" },
                "shippingDetails": {
                    "@type": "OfferShippingDetails",
                    "shippingRate": { "@type": "MonetaryAmount", "value": "0.00", "currency": "USD" },
                    "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "US" },
                    "deliveryTime": {
                        "@type": "ShippingDeliveryTime",
                        "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY" },
                        "transitTime": { "@type": "QuantitativeValue", "minValue": 3, "maxValue": 5, "unitCode": "DAY" }
                    }
                },
                "hasMerchantReturnPolicy": {
                    "@type": "MerchantReturnPolicy",
                    "applicableCountry": "US",
                    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
                    "merchantReturnDays": 30,
                    "returnMethod": "https://schema.org/ReturnByMail",
                    "returnFees": "https://schema.org/FreeReturn"
                }
            }
        }

        schema_tag = f'<script type="application/ld+json" id="eseb-static-schema">\n{json.dumps(schema_json, indent=2)}\n</script>'

        with open(index_path, "r", encoding="utf-8") as f:
            html_content = f.read()

        html_content = re.sub(r'<script type="application/ld\+json" id="eseb-static-schema">.*?</script>', '', html_content, flags=re.DOTALL)

        if "</head>" in html_content:
            html_content = html_content.replace("</head>", f"{schema_tag}\n</head>")
            with open(index_path, "w", encoding="utf-8") as f:
                f.write(html_content)
            print("[SCHEMA_ACCELERATOR] Merchant Listings validFrom injected into index.html.")

