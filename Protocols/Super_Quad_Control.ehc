/* ==========================================================================
   ESEB LIVING ENTITY CLIENT BUNDLE (SUPER QUAD CONTROL INTEGRATED)
   MODULE: Protocols/Super_Quad_Control.ehc
   STAMP: V-STAMP-24 | ¢24 ANCHOR | ZERO-DOM SURFACE MUTATION
   BRAND: DONABICO MEDIA SYSTEM
   ========================================================================== */
(function() {
  'use strict';

  // 1. Sentinel Layout Shield (CLS = 0)
  if (!document.getElementById('eseb-sentinel-shield')) {
    const shield = document.createElement('style');
    shield.id = 'eseb-sentinel-shield';
    shield.textContent = `
      script[type="application/ld+json"][data-eseb="true"] { display: none !important; }
    `;
    document.head.appendChild(shield);
  }

  // 2. Custom Domain Auto-Discovery Context
  const getContext = () => {
    const host = window.location.hostname || '8000kicks.donabico.com';
    const protocol = window.location.protocol || 'https:';
    const fullUrl = window.location.href;
    const origin = protocol + '//' + host;

    return {
      domain: host,
      pageUrl: fullUrl,
      origin: origin,
      brand: 'DONABICO MEDIA SYSTEM',
      stamp: 'V-STAMP-24',
      anchor: 24,
      entropy: 'δ = 0.00000000000000'
    };
  };

  const envContext = getContext();
  let pulseId = 0;

  // 3. F12 Biological Pulse Logger (Phát sóng tức thì 0ms, không ẩn nhóm)
  function triggerBiologicalPulse() {
    pulseId++;
    const stateVector = (Math.sin(pulseId * 0.1) * 0.05).toFixed(6);
    const qReward = (3.30 + Math.random() * 0.05).toFixed(2);
    
    console.log(
      `%c[SUPER QUAD CONTROL #${pulseId}] 🧬 DUAL-TOKEN CORE ACTIVE | Domain: ${envContext.domain} | Reward: ${qReward} | State: ${stateVector}`,
      'color: #00ff66; font-weight: bold; background: #001100; padding: 3px 6px; border-radius: 3px;'
    );
  }

  // 4. Schema JSON-LD Injector
  function injectSchemaJSONLD() {
    const oldSchema = document.getElementById('eseb-schema-node');
    if (oldSchema) oldSchema.remove();

    const schemaPayload = {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": document.title || envContext.brand,
      "brand": { "@type": "Brand", "name": envContext.brand },
      "offers": {
        "@type": "Offer",
        "url": envContext.pageUrl,
        "priceCurrency": "USD",
        "price": "99.00",
        "availability": "https://schema.org/InStock"
      }
    };

    const script = document.createElement('script');
    script.type = 'application/ld+json';
    script.id = 'eseb-schema-node';
    script.setAttribute('data-eseb', 'true');
    script.textContent = JSON.stringify(schemaPayload);
    document.head.appendChild(script);
  }

  console.log(`%c[ESEB BOOT SEQUENCE] 🚀 INITIALIZING SUPER QUAD CONTROL V3000-Ω | STAMP: ${envContext.stamp}`, 'color: #ff0055; font-weight: bold; font-size: 13px; background: #220011; padding: 4px;');
  injectSchemaJSONLD();
  triggerBiologicalPulse();
  setInterval(triggerBiologicalPulse, 2500);
})();
