/* ===============================================================================
   ESEB DYNAMIC LIVING ENTITY - STANDALONE TRAFFIC TURBOCHARGER (CLIENT SIDE)
   MODULE: Protocols/Traffic_Turbocharger.ehc
   STAMP: V-STAMP-24 | ZERO-DOM SURFACE MUTATION ENFORCED
   BRAND: DONABICO GLOBAL MEDIA SYSTEM
 =============================================================================== */
(function() {
  'use strict';

  const getContext = () => {
    const pathSegments = window.location.pathname.split('/').filter(Boolean);
    const repoName = pathSegments.length > 0 ? pathSegments[0] : '8000kicks';
    const host = window.location.hostname || 'donabico-global-media.github.io';
    const protocol = window.location.protocol || 'https:';
    const fullUrl = window.location.href;

    return {
      repo: repoName,
      domain: host,
      canonicalUrl: fullUrl,
      origin: protocol + '//' + host,
      brand: 'DONABICO GLOBAL MEDIA SYSTEM',
      stamp: 'V-STAMP-24'
    };
  };

  const env = getContext();

  // 1. Sentinel CLS Shield (Khóa giật khung hình UI)
  if (!document.getElementById('eseb-sentinel-turbo')) {
    const styleSentinel = document.createElement('style');
    styleSentinel.id = 'eseb-sentinel-turbo';
    styleSentinel.textContent = 'script[type="application/ld+json"][data-eseb="true"] { display: none !important; } a.aff-turbo { cursor: pointer; }';
    document.head.appendChild(styleSentinel);
  }

  // 2. Chuyển đổi liên kết siêu tốc & Tải trước (Speculative Prefetching 0ms)
  const armAffiliateLinks = () => {
    const urlParams = new URLSearchParams(window.location.search);
    const utmSource = urlParams.get('utm_source') || 'eseb_organic_turbo';
    const utmMedium = urlParams.get('utm_medium') || 'traffic_siphon_engine';

    document.querySelectorAll('a[href*="affiliate"], a[href*="shop"], a[href*="out"], .cta-btn, button[data-href]').forEach(link => {
      try {
        let href = link.href || link.getAttribute('data-href');
        if (!href) return;
        
        const targetUrl = new URL(href, window.location.origin);
        targetUrl.searchParams.set('utm_source', utmSource);
        targetUrl.searchParams.set('utm_medium', utmMedium);
        targetUrl.searchParams.set('eseb_stamp', env.stamp);
        
        if (link.tagName === 'A') link.href = targetUrl.toString();

        // Tải trước liên kết mua hàng khi người dùng vừa rê chuột tới (Prefetch 0ms)
        if (!link.dataset.turboArmed) {
          link.dataset.turboArmed = "true";
          link.addEventListener('pointerover', () => {
            const p = document.createElement('link');
            p.rel = 'prefetch';
            p.href = targetUrl.toString();
            document.head.appendChild(p);
          }, { once: true });
        }
      } catch(e) {}
    });
  };

  // 3. Nhịp thở Biological Pulse F12 (2.5s)
  let pulseCount = 0;
  const runTurboPulse = () => {
    pulseCount++;
    armAffiliateLinks();
    
    if (pulseCount % 4 === 0) {
      console.log("%c[ESEB TURBOCHARGER ACTIVE] %cTraffic Siphon Ready | Zero Latency Link Armed", "color: #00FF66; font-weight: bold;", "color: #00E5FF;");
    }
  };

  runTurboPulse();
  setInterval(runTurboPulse, 2500);
})();
