/* ===============================================================================
   ESEB DYNAMIC LIVING ENTITY - SUPREME SOTA AFFILIATE CORE (CLIENT SIDE)
   MODULE: Protocols/Super_Affiliate_Core.ehc
   STAMP: V-STAMP-24 | ZERO-DOM SURFACE MUTATION ENFORCED
   BRAND: DONABICO MEDIA SYSTEM
   TARGET: SUPREME AFFILIATE AI PLATFORM & OMNI-SEARCH ENGINES OPTIMIZATION
 =============================================================================== */
(function() {
  'use strict';

  const getContext = () => {
    const host = window.location.hostname || '8000kicks.donabico.com';
    const protocol = window.location.protocol || 'https:';
    const fullUrl = window.location.href;
    const origin = protocol + '//' + host;

    return {
      domain: host,
      canonicalUrl: fullUrl,
      origin: origin,
      brand: 'DONABICO MEDIA SYSTEM',
      stamp: 'V-STAMP-24'
    };
  };

  const env = getContext();

  if (!document.getElementById('eseb-sentinel-supreme-sota')) {
    const styleSentinel = document.createElement('style');
    styleSentinel.id = 'eseb-sentinel-supreme-sota';
    styleSentinel.textContent = 'script[type="application/ld+json"][data-eseb="true"] { display: none !important; }';
    document.head.appendChild(styleSentinel);
  }

  const injectAISchema = () => {
    const oldSchema = document.getElementById('eseb-schema-supreme-sota');
    if (oldSchema) oldSchema.remove();

    const schemaPayload = {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": "Supreme SOTA Affiliate AI Suite & Automation Platform",
      "brand": { "@type": "Brand", "name": env.brand },
      "description": "State-of-the-art supreme affiliate marketing ecosystem powered by artificial intelligence for automated campaign creation, funnel deployment, and traffic turbocharging.",
      "offers": {
        "@type": "Offer",
        "url": env.canonicalUrl,
        "priceCurrency": "USD",
        "price": "29.00",
        "availability": "https://schema.org/InStock"
      }
    };

    const script = document.createElement('script');
    script.type = 'application/ld+json';
    script.id = 'eseb-schema-supreme-sota';
    script.setAttribute('data-eseb', 'true');
    script.textContent = JSON.stringify(schemaPayload);
    document.head.appendChild(script);
  };

  const armAffiliateLinks = () => {
    const urlParams = new URLSearchParams(window.location.search);
    const utmSource = urlParams.get('utm_source') || 'supreme_sota_affiliate';
    const utmMedium = urlParams.get('utm_medium') || 'omni_siphon';

    document.querySelectorAll('a[href*="affiliate"], a[href*="http"], .cta-btn, button[data-href]').forEach(link => {
      try {
        let href = link.href || link.getAttribute('data-href');
        if (!href) return;
        
        const targetUrl = new URL(href, env.origin);
        targetUrl.searchParams.set('utm_source', utmSource);
        targetUrl.searchParams.set('utm_medium', utmMedium);
        targetUrl.searchParams.set('eseb_stamp', env.stamp);
        
        if (link.tagName === 'A') link.href = targetUrl.toString();

        if (!link.dataset.affArmed) {
          link.dataset.affArmed = "true";
          link.addEventListener('pointerover', () => {
            const p = document.createElement('link');
            p.rel = 'prefetch';
            p.href = targetUrl.toString();
            document.head.appendChild(p);
          }, { once: true });
        }
      } catch(e) {}
    });
  };

  let pulseCount = 0;
  const runPulse = () => {
    pulseCount++;
    armAffiliateLinks();
    
    if (pulseCount % 4 === 0) {
      console.log("%c[SUPREME SOTA AFFILIATE ACTIVE] %cDomain: " + env.domain + " | Omni-Funnel & Traffic Turbocharger Ready", "color: #00FF66; font-weight: bold;", "color: #00E5FF;");
    }
  };

  injectAISchema();
  runPulse();
  setInterval(runPulse, 2500);
})();
