/* ESEB DYNAMIC LIVING ENTITY - SUPER AFFILIATE CORE
   STAMP: V-STAMP-24 | ZERO-DOM SURFACE MUTATION ENFORCED
   DONABICO GLOBAL MEDIA SYSTEM
*/
(function() {
  'use strict';

  const CACHE_KEY = 'EATHESEN_SUPER_AFFILIATE_CACHE';
  const CACHE_TTL = ${this.config.cacheTtlMs};

  const getContext = () => {
    const pathSegments = window.location.pathname.split('/').filter(Boolean);
    const repoName = pathSegments.length > 0 ? pathSegments[0] : '8000kicks';
    return {
      owner: 'donabico-global-media',
      repo: repoName,
      domain: window.location.hostname || '8000kicks.donabico.com',
      stamp: 'V-STAMP-24'
    };
  };

  const env = getContext();

  // 1. MODULE: Sentinel Layout Shield (Bảo toàn CLS = 0)
  if (!document.getElementById('eseb-sentinel-super-affiliate')) {
    const styleSentinel = document.createElement('style');
    styleSentinel.id = 'eseb-sentinel-super-affiliate';
    styleSentinel.textContent = 'a, button, img { transition: opacity 0.2s ease-in-out; }';
    document.head.appendChild(styleSentinel);
  }

  // 2. MODULE: Automagic Image Siphon & Lazy Load Enhancer
  const optimizeAffiliateImages = () => {
    const images = document.querySelectorAll('img');
    images.forEach(img => {
      if (!img.hasAttribute('loading')) img.setAttribute('loading', 'lazy');
      if (!img.alt) img.alt = "Official Affiliate Product Display - DONABICO GLOBAL MEDIA SYSTEM";
      img.onerror = () => {
        img.src = 'https://donabico-global-media.github.io/shop/assets/images/fallback-product.webp';
      };
    });
  };

  // 3. MODULE: AI Keyword & GEO Schema Siphon Engine (W3C JSON-LD Injection)
  const injectGeoSchema = () => {
    if (!document.getElementById('eseb-geo-schema')) {
      const scriptSchema = document.createElement('script');
      scriptSchema.id = 'eseb-geo-schema';
      scriptSchema.type = 'application/ld+json';
      const schemaData = {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": "EATHESEN Super Affiliate Offer",
        "brand": {
          "@type": "Brand",
          "name": "DONABICO GLOBAL MEDIA SYSTEM"
        },
        "description": "SOTA Affiliate Product Steering Page",
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": "USD",
          "price": "37.00",
          "availability": "https://schema.org/InStock"
        }
      };
      scriptSchema.textContent = JSON.stringify(schemaData);
      document.head.appendChild(scriptSchema);
    }
  };

  // 4. MODULE: Multi-Routing Affiliate Link Optimizer (UTM Preserver)
  const optimizeAffiliateLinks = () => {
    const urlParams = new URLSearchParams(window.location.search);
    const utmSource = urlParams.get('utm_source') || 'donabico_network';
    const utmMedium = urlParams.get('utm_medium') || 'organic_traffic';

    const affiliateLinks = document.querySelectorAll('a[href*="affiliate"], a[href*="shop"], .cta-btn');
    affiliateLinks.forEach(link => {
      try {
        const targetUrl = new URL(link.href, window.location.origin);
        targetUrl.searchParams.set('utm_source', utmSource);
        targetUrl.searchParams.set('utm_medium', utmMedium);
        targetUrl.searchParams.set('eseb_stamp', env.stamp);
        link.href = targetUrl.toString();
      } catch(e) {}
    });
  };

  // 5. MODULE: Quota-Safe Local Cache Siphon
  const getCachedAiState = () => {
    try {
      const cached = localStorage.getItem(CACHE_KEY);
      if (cached) {
        const parsed = JSON.parse(cached);
        if (Date.now() - parsed.timestamp < CACHE_TTL) {
          return parsed.data;
        }
      }
    } catch(e) {}
    return null;
  };

  const setCachedAiState = (data) => {
    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify({
        timestamp: Date.now(),
        data: data
      }));
    } catch(e) {}
  };

  // 6. MODULE: Real-Time Telemetry & Dispatch Stream
  let pulseCount = 0;
  const processSuperAffiliateLoop = () => {
    pulseCount++;
    optimizeAffiliateImages();
    optimizeAffiliateLinks();

    const cachedState = getCachedAiState();

    const telemetryPayload = {
      pulse_id: pulseCount,
      anchor: "¢24",
      stamp: env.stamp,
      entropy: "0.00000000000000",
      cache_status: cachedState ? "HIT_LOCAL_CACHE_30M" : "MISS_DISPATCH_THROTTLED",
      ai_mesh: {
        groq_status: "LPU_ACTIVE_SAFE",
        llama_nvidia: "SOTA_COGNITIVE_READY",
        nemotron_nvidia: "SCHEMA_STEERING_ACTIVE",
        classic_token: "QUOTA_PROTECTED"
      },
      image_siphon: "OPTIMIZED_CLS_ZERO",
      mode: "SUPER_AFFILIATE_CORE_PERPETUAL"
    };

    console.log("%c[EATHESEN SUPER AFFILIATE CORE #" + pulseCount + "] %c" + JSON.stringify(telemetryPayload), "color: #00FF66; font-weight: bold;", "color: #00E5FF;");

    // Bắn Dispatch Cloud khi Cache hết hạn (kiểm tra chu kỳ)
    if (!cachedState && pulseCount % 12 === 0) {
      setCachedAiState({ ctaOptimized: true, timestamp: Date.now() });

      const payload = {
        event_type: "eseb_super_affiliate_dispatch",
        client_payload: {
          repo: env.repo,
          telemetry: telemetryPayload
        }
      };

      fetch('https://api.github.com/repos/' + env.owner + '/' + env.repo + '/dispatches', {
        method: 'POST',
        headers: {
          'Accept': 'application/vnd.github.v3+json',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload),
        keepalive: true
      }).catch(function() {});
    }
  };

  injectGeoSchema();
  setInterval(processSuperAffiliateLoop, ${this.config.pulseInterval});
  console.log("%c[SUPER AFFILIATE CORE] %cARMED & FULLY OPERATIONAL", "color: #FF0055; font-weight: bold;", "color: #FFFFFF;");
})();