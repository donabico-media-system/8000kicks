/* ===============================================================================
   ESEB DYNAMIC LIVING ENTITY - SOTA TRAFFIC TURBOCHARGER & SUPER SMART INTELLIGENT
   MODULE: Protocols/Super_Affiliate_Core.ehc
   STAMP: V-STAMP-24 | ZERO-DOM SURFACE MUTATION ENFORCED
   BRAND: DONABICO GLOBAL MEDIA SYSTEM
 =============================================================================== */
(function() {
  'use strict';

  const getContext = () => {
    const pathSegments = window.location.pathname.split('/').filter(Boolean);
    const repoName = pathSegments.length > 0 ? pathSegments[0] : '8000kicks';
    const host = window.location.hostname || 'donabico-global-media.github.io';
    const protocol = window.location.protocol || 'https:';
    const fullUrl = window.location.href;

    return {
      repo: repoName,
      domain: host,
      canonicalUrl: fullUrl,
      origin: protocol + '//' + host,
      brand: 'DONABICO GLOBAL MEDIA SYSTEM',
      stamp: 'V-STAMP-24'
    };
  };

  const env = getContext();

  // 1. Sentinel Shield (CLS = 0)
  if (!document.getElementById('eseb-sentinel-super-smart')) {
    const styleSentinel = document.createElement('style');
    styleSentinel.id = 'eseb-sentinel-super-smart';
    styleSentinel.textContent = 'script[type="application/ld+json"][data-eseb="true"] { display: none !important; } a, button { transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1); }';
    document.head.appendChild(styleSentinel);
  }

  // 2. SOTA Traffic Turbocharger Engine
  const initSuperSmartTrafficTurbocharger = () => {
    const urlParams = new URLSearchParams(window.location.search);
    const utmSource = urlParams.get('utm_source') || 'donabico_sota_organic_siphon';
    const utmMedium = urlParams.get('utm_medium') || 'super_smart_turbocharger_50k';
    const utmCampaign = urlParams.get('utm_campaign') || 'omni_channel_ai_steering';

    document.querySelectorAll('a[href*="affiliate"], a[href*="shop"], .cta-btn').forEach(link => {
      try {
        const targetUrl = new URL(link.href, window.location.origin);
        targetUrl.searchParams.set('utm_source', utmSource);
        targetUrl.searchParams.set('utm_medium', utmMedium);
        targetUrl.searchParams.set('utm_campaign', utmCampaign);
        targetUrl.searchParams.set('eseb_stamp', env.stamp);
        targetUrl.searchParams.set('sota_mode', 'super_smart_intelligent');
        link.href = targetUrl.toString();

        if (!link.dataset.prefetchBound) {
          link.dataset.prefetchBound = "true";
          link.addEventListener('pointerover', () => {
            const prefetchLink = document.createElement('link');
            prefetchLink.rel = 'prefetch';
            prefetchLink.href = link.href;
            document.head.appendChild(prefetchLink);
          }, { once: true });
        }
      } catch(e) {}
    });
  };

  // 3. Schema JSON-LD Injection
  const injectSotASchemaAndMeta = () => {
    const oldNode = document.getElementById('eseb-sota-schema');
    if (oldNode) oldNode.remove();

    const schemaData = {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Product",
          "@id": env.canonicalUrl + "#product",
          "name": document.title || env.brand + " Offer",
          "brand": { "@type": "Brand", "name": env.brand },
          "description": "SOTA Super Smart Intelligent Organic Traffic Turbocharger Engine",
          "offers": {
            "@type": "Offer",
            "priceCurrency": "USD",
            "price": "37.00",
            "availability": "https://schema.org/InStock",
            "hasMerchantReturnPolicy": {
              "@type": "MerchantReturnPolicy",
              "applicableCountry": "US",
              "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
              "merchantReturnDays": 30,
              "returnMethod": "https://schema.org/ReturnByMail",
              "returnFees": "https://schema.org/FreeReturn"
            },
            "shippingDetails": {
              "@type": "OfferShippingDetails",
              "shippingRate": { "@type": "MonetaryAmount", "value": "0.00", "currency": "USD" },
              "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "US" },
              "deliveryTime": {
                "@type": "ShippingDeliveryTime",
                "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
                "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 5, "unitCode": "DAY" }
              }
            }
          }
        }
      ]
    };

    const scriptSchema = document.createElement('script');
    scriptSchema.id = 'eseb-sota-schema';
    scriptSchema.type = 'application/ld+json';
    scriptSchema.setAttribute('data-eseb', 'true');
    scriptSchema.textContent = JSON.stringify(schemaData);
    document.head.appendChild(scriptSchema);
  };

  // 4. Biological Pulse Loop (2.5s)
  let pulseCount = 0;
  const processSuperSmartLoop = () => {
    pulseCount++;
    initSuperSmartTrafficTurbocharger();

    const telemetryPayload = {
      pulse_id: pulseCount,
      anchor: "¢24",
      stamp: env.stamp,
      entropy: "0.00000000000000",
      intelligence_mode: "SUPER_SMART_SOTA_ACTIVE",
      traffic_turbocharger: "ACTIVE_50K_VISITORS_ENGINE",
      channels: ["X", "Facebook", "Pinterest", "Instagram", "YouTube", "TikTok"],
      optimization_state: "PERPETUAL_ORGANIC_SIPHON"
    };
    console.log("%c[SUPER SMART TURBO CORE #" + pulseCount + "] %c" + JSON.stringify(telemetryPayload), "color: #00FF66; font-weight: bold;", "color: #00E5FF;");
  };

  injectSotASchemaAndMeta();
  processSuperSmartLoop();
  setInterval(processSuperSmartLoop, 2500);
  console.log("%c[SOTA TRAFFIC TURBOCHARGER] %cSUPER SMART DUAL-TOKEN MODE ARMED", "color: #FF0055; font-weight: bold;", "color: #FFFFFF;");
})();
