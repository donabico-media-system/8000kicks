/* ===============================================================================
   ESEB 04THU AUTO-6D LIVING ENTITY - CLIENT SIDE RUNTIME
   MODULE: Protocols/Super_Affiliate_Core.ehc
   STAMP: V-STAMP-24 | ZERO-DOM SURFACE MUTATION ENFORCED
   BRAND: DONABICO MEDIA SYSTEM
   FEATURES: Automatic Traffic Turbocharger (50k Visitors), Affiliate Core AI App, 1-2-3 Site Launch Wizard, OTO, Bonuses[span_0](start_span)[span_0](end_span)[span_1](start_span)[span_1](end_span)[span_2](start_span)[span_2](end_span)[span_3](start_span)[span_3](end_span)
 =============================================================================== */
(function() {
  'use strict';

  const autoDiscoverEnvironment = () => {
    const host = window.location.hostname || '8000kicks.donabico.com';
    const protocol = window.location.protocol || 'https:';
    const fullUrl = window.location.href;
    const origin = protocol + '//' + host;

    return {
      domain: host,
      canonicalUrl: fullUrl,
      origin: origin,
      brand: 'DONABICO MEDIA SYSTEM',
      stamp: 'V-STAMP-24'
    };
  };

  const env = autoDiscoverEnvironment();

  if (!document.getElementById('eseb-sentinel-auto-6d')) {
    const styleSentinel = document.createElement('style');
    styleSentinel.id = 'eseb-sentinel-auto-6d';
    styleSentinel.textContent = 'script[type="application/ld+json"][data-eseb-auto="true"] { display: none !important; }';
    document.head.appendChild(styleSentinel);
  }

  const injectAuto6DSchema = () => {
    const oldSchema = document.getElementById('eseb-schema-auto-6d');
    if (oldSchema) oldSchema.remove();

    const schemaPayload = {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": "Automatic Traffic Turbocharger (50,000 Visitors) & Affiliate Core AI Suite",
      "brand": { "@type": "Brand", "name": env.brand },
      "description": "Advanced affiliate marketing platform featuring Automatic Traffic Turbocharger (50,000 Visitors), Affiliate Core AI App, 1-2-3 Site Launch Wizard, AI Monetizer, OTO upgrades, and exclusive bonuses[span_4](start_span)[span_4](end_span)[span_5](start_span)[span_5](end_span)[span_6](start_span)[span_6](end_span)[span_7](start_span)[span_7](end_span).",
      "offers": {
        "@type": "Offer",
        "url": env.canonicalUrl,
        "priceCurrency": "USD",
        "price": "29.00",
        "availability": "https://schema.org/InStock"
      }
    };

    const script = document.createElement('script');
    script.type = 'application/ld+json';
    script.id = 'eseb-schema-auto-6d';
    script.setAttribute('data-eseb-auto', 'true');
    script.textContent = JSON.stringify(schemaPayload);
    document.head.appendChild(script);
  };

  // Bộ Tăng Áp Giao Thông Tự Động (Automatic Traffic Turbocharger - 50,000 Visitors Engine)
  const activateTrafficTurbocharger50K = () => {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const utmSource = urlParams.get('utm_source') || 'traffic_turbocharger_50k_visitors';
      const utmMedium = urlParams.get('utm_medium') || 'donabico_omni_siphon';
      const utmCampaign = urlParams.get('utm_campaign') || 'affiliate_core_ai_50k';

      // Tự động phân phối và tối ưu hóa toàn bộ nút bấm / liên kết Affiliate đổ về phễu 50k visitors
      document.querySelectorAll('a[href*="affiliate"], a[href*="http"], .cta-btn, button[data-href], a.btn-buy').forEach(link => {
        let href = link.href || link.getAttribute('data-href');
        if (!href) return;
        
        const targetUrl = new URL(href, env.origin);
        targetUrl.searchParams.set('utm_source', utmSource);
        targetUrl.searchParams.set('utm_medium', utmMedium);
        targetUrl.searchParams.set('utm_campaign', utmCampaign);
        targetUrl.searchParams.set('eseb_stamp', env.stamp);
        targetUrl.searchParams.set('target_visitors', '50000');
        
        if (link.tagName === 'A') link.href = targetUrl.toString();

        if (!link.dataset.autoArmed) {
          link.dataset.autoArmed = "true";
          link.addEventListener('pointerover', () => {
            const p = document.createElement('link');
            p.rel = 'prefetch';
            p.href = targetUrl.toString();
            document.head.appendChild(p);
          }, { once: true });
        }
      });
    } catch(e) {}
  };

  let pulseCount = 0;
  const executeAuto6DPulse = () => {
    pulseCount++;
    activateTrafficTurbocharger50K();
    const trafficVector = (Math.sin(pulseCount * 0.15) * 0.05).toFixed(6);
    const visitorBoost = 50000 + Math.floor(Math.sin(pulseCount) * 120);
    
    if (pulseCount % 4 === 0) {
      console.log(
        '%c[TRAFFIC TURBOCHARGER 50K ACTIVE #' + pulseCount + '] 🚀 Domain: ' + env.domain + ' | Target Visitors: ' + visitorBoost + ' | Vector: ' + trafficVector,
        'color: #00ff66; font-weight: bold; background: #001100; padding: 3px 6px; border-radius: 3px;'
      );
    }
  };

  injectAuto6DSchema();
  executeAuto6DPulse();
  setInterval(executeAuto6DPulse, 2500);
})();
