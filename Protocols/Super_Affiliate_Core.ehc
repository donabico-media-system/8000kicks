/* ===============================================================================
   ESEB DYNAMIC LIVING ENTITY - SUPER SMART INTELLIGENT MODE (CLIENT SIDE)
   MODULE: Protocols/Super_Affiliate_Core.ehc
   STAMP: V-STAMP-24 | ZERO-DOM SURFACE MUTATION ENFORCED
   BRAND: DONABICO MEDIA SYSTEM
   TARGET: SUPER SMART INTELLIGENT MODE AFFILIATE & OMNI-SEARCH ENGINES
 =============================================================================== */
(function() {
  'use strict';

  const getContext = () => {
    const host = window.location.hostname || '8000kicks.donabico.com';
    const protocol = window.location.protocol || 'https:';
    const fullUrl = window.location.href;
    const origin = protocol + '//' + host;

    return {
      domain: host,
      canonicalUrl: fullUrl,
      origin: origin,
      brand: 'DONABICO MEDIA SYSTEM',
      stamp: 'V-STAMP-24'
    };
  };

  const env = getContext();

  if (!document.getElementById('eseb-sentinel-super-smart-mode')) {
    const styleSentinel = document.createElement('style');
    styleSentinel.id = 'eseb-sentinel-super-smart-mode';
    styleSentinel.textContent = 'script[type="application/ld+json"][data-eseb="true"] { display: none !important; }';
    document.head.appendChild(styleSentinel);
  }

  // Super Smart Intelligent Schema Injection cho AI Search Engines
  const injectAISchema = () => {
    const oldSchema = document.getElementById('eseb-schema-super-smart-mode');
    if (oldSchema) oldSchema.remove();

    const schemaPayload = {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": "Super Smart Intelligent Mode Affiliate Suite",
      "brand": { "@type": "Brand", "name": env.brand },
      "description": "State-of-the-art affiliate marketing ecosystem operating under Super Smart Intelligent Mode.",
      "offers": {
        "@type": "Offer",
        "url": env.canonicalUrl,
        "priceCurrency": "USD",
        "price": "29.00",
        "availability": "https://schema.org/InStock"
      }
    };

    const script = document.createElement('script');
    script.type = 'application/ld+json';
    script.id = 'eseb-schema-super-smart-mode';
    script.setAttribute('data-eseb', 'true');
    script.textContent = JSON.stringify(schemaPayload);
    document.head.appendChild(script);
  };

  const armAffiliateLinks = () => {
    const urlParams = new URLSearchParams(window.location.search);
    const utmSource = urlParams.get('utm_source') || 'super_smart_intelligent_mode';
    const utmMedium = urlParams.get('utm_medium') || 'omni_siphon';

    document.querySelectorAll('a[href*="affiliate"], a[href*="http"], .cta-btn, button[data-href]').forEach(link => {
      try {
        let href = link.href || link.getAttribute('data-href');
        if (!href) return;
        
        const targetUrl = new URL(href, env.origin);
        targetUrl.searchParams.set('utm_source', utmSource);
        targetUrl.searchParams.set('utm_medium', utmMedium);
        targetUrl.searchParams.set('eseb_stamp', env.stamp);
        
        if (link.tagName === 'A') link.href = targetUrl.toString();

        if (!link.dataset.affArmed) {
          link.dataset.affArmed = "true";
          link.addEventListener('pointerover', () => {
            const p = document.createElement('link');
            p.rel = 'prefetch';
            p.href = targetUrl.toString();
            document.head.appendChild(p);
          }, { once: true });
        }
      } catch(e) {}
    };
  };

  let pulseCount = 0;
  const runSuperSmartPulse = () => {
    pulseCount++;
    armAffiliateLinks();
    const adaptiveState = (Math.sin(pulseCount * 0.15) * 0.05).toFixed(6);
    const intelligentReward = (3.48 + Math.random() * 0.03).toFixed(2);
    
    if (pulseCount % 4 === 0) {
      console.log(
        `%c[SUPER SMART INTELLIGENT MODE #${pulseCount}] 🧬 Domain: ${env.domain} | Reward: ${intelligentReward} | State: ${adaptiveState}`,
        'color: #00ff66; font-weight: bold; background: #001100; padding: 3px 6px; border-radius: 3px;'
      );
    }
  };

  injectAISchema();
  runSuperSmartPulse();
  setInterval(runSuperSmartPulse, 2500);
})();
